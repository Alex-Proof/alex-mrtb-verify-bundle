{
  "name": "verify-bundle",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/verify.js",
  "files": [
    "dist/",
    "README.md",
    "sample-bundle.json",
    "invalid-tampered-bundle.json",
    "test/",
    "spec/",
    "verify.py",
    "trust-anchor.json",
    "independence/",
    "bundle-*.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build --silent && node --test test/*.test.mjs",
    "verify": "npm run build --silent && node dist/verify.js",
    "verify:python": "python3 verify.py",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@peculiar/asn1-cms": "^2.9.4",
    "@peculiar/asn1-schema": "^2.9.4",
    "@peculiar/asn1-x509": "^2.9.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2"
  }
}
